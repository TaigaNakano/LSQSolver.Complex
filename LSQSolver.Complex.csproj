<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<Version>1.0.0</Version>
		<Title>LSQSolver.Complex</Title>
		<Authors>TaigaNakano</Authors>
		<Copyright>TaigaNakano</Copyright>

		<PackageIcon>Project_icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<RepositoryUrl>https://github.com/TaigaNakano/LSQSolver.Complex</RepositoryUrl>
		<PackageProjectUrl>https://github.com/TaigaNakano/LSQSolver.Complex</PackageProjectUrl>
		<Description>Complex number extension of LSQSolver</Description>
		<PackageTags>LSQSolver;Linear Algebra;Least Square</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="LSQSolver" Version="1.0.5" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Assets\Project_icon.png" />
		<None Include="Assets\Project_icon.png" Pack="true" PackagePath="\" />

		<None Update="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>